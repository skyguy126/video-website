---
import { SITE } from '../data/site';
import { withBase } from '../lib/paths';
---

<section class="hero" id="hero">
	<div class="heroContent">
		<div class="heroText">
			<h1 class="text-white mt-5 mb-lg-4">{SITE.name}</h1>
			<p class="text-secondary-white-color">
				bay area photography and <strong class="custom-underline">videography</strong>
			</p>
		</div>

		<div class="scrollCue" aria-hidden="true">
			<span class="scrollCue__mouse">
				<span class="scrollCue__wheel"></span>
			</span>
			<span class="scrollCue__chevron"></span>
		</div>
	</div>

	<div class="videoWrapper">
		<video
			autoplay
			loop
			muted
			playsinline
			webkit-playsinline
			disablepictureinpicture
			class="custom-video"
			poster={withBase('/videos/poster.jpg')}
		>
			<source src={withBase('/videos/website_video.mp4')} type="video/mp4" />
			Your browser does not support the video tag.
		</video>
	</div>

	<div class="overlay"></div>
</section>
